rules_version = '2';

// Acceso:
//  - Jefe de Grupo (correo fijo): todo.
//  - Dirigentes: cuenta con correo verificado Y presente/activo en /usuarios/{correo},
//    que solo el Jefe puede modificar.
// Hay datos personales y médicos de menores (Ley 8968): no ampliar sin revisar.
service cloud.firestore {
  match /databases/{database}/documents {
    function verificado() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function esJefe() {
      return verificado() && request.auth.token.email == 'german.gs19@gmail.com';
    }
    function esDirigente() {
      return verificado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.token.email))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.token.email)).data.activo != false;
    }

    // Lista de dirigentes: solo el Jefe escribe; cada quien puede leer su propio registro
    match /usuarios/{correo} {
      allow read: if esJefe() || (verificado() && request.auth.token.email == correo);
      allow write: if esJefe();
    }

    // Ajustes: los dirigentes leen, el Jefe modifica
    match /config/{id} {
      allow read: if esJefe() || esDirigente();
      allow write: if esJefe();
    }

    // Datos de la Tropa
    match /{coleccion}/{id} {
      allow read, write: if (coleccion in ['patrullas', 'protagonistas', 'ciclos', 'reuniones', 'puntosExtra'])
        && (esJefe() || esDirigente());
    }
  }
}
